{
  "manifest_version": 3,
  "name": "TG Media Saver (Web K/A)",
  "version": "1.3.3",
  "minimum_chrome_version": "111",
  "description": "Save videos, audio and photos from Telegram Web K and Web A, including chats with restricted saving. The save directory is granted once.",
  "author": "Denis Ermilov (original), fork maintained by yanyintingyou",
  "homepage_url": "https://github.com/yanyintingyou/tg-media-saver-yanyin",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/k/*",
        "https://web.telegram.org/a/*",
        "https://webk.telegram.org/*",
        "https://weba.telegram.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
